{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "metrics": {
    "namespace": "CWAgent",
    "append_dimensions": { "InstanceId": "${aws:InstanceId}" },
    "metrics_collected": {
      "mem":  { "measurement": ["mem_used_percent"] },
      "disk": { "measurement": ["used_percent"], "resources": ["/"] }
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          { "file_path": "/var/log/andysmotors/web.log",     "log_group_name": "/andysmotors/plataformas", "log_stream_name": "web",     "retention_in_days": 7 },
          { "file_path": "/var/log/andysmotors/stock.log",   "log_group_name": "/andysmotors/plataformas", "log_stream_name": "stock",   "retention_in_days": 7 },
          { "file_path": "/var/log/andysmotors/agenda.log",  "log_group_name": "/andysmotors/plataformas", "log_stream_name": "agenda",  "retention_in_days": 7 },
          { "file_path": "/var/log/andysmotors/crm.log",     "log_group_name": "/andysmotors/plataformas", "log_stream_name": "crm",     "retention_in_days": 7 },
          { "file_path": "/var/log/andysmotors/pagos.log",   "log_group_name": "/andysmotors/plataformas", "log_stream_name": "pagos",   "retention_in_days": 7 },
          { "file_path": "/var/log/andysmotors/gateway.log", "log_group_name": "/andysmotors/plataformas", "log_stream_name": "gateway", "retention_in_days": 7 }
        ]
      }
    }
  }
}